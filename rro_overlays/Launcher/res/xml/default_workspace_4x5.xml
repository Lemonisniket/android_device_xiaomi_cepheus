<?xml version="1.0" encoding="utf-8"?>
<favorites xmlns:launcher="http://schemas.android.com/apk/res-auto/com.android.launcher3">

    <resolve launcher:container="-101" launcher:screen="0" launcher:x="0" launcher:y="0" >
        <favorite launcher:packageName="com.google.android.dialer" />
        <favorite launcher:packageName="com.android.dialer" />
        <favorite launcher:uri="tel:" />
    </resolve>

    <resolve launcher:container="-101" launcher:screen="1" launcher:x="1" launcher:y="0" >
        <favorite launcher:packageName="com.google.android.apps.messaging" />
        <favorite launcher:packageName="com.android.messaging" />
        <favorite launcher:uri="sms:" />
    </resolve>

    <resolve launcher:container="-101" launcher:screen="2" launcher:x="2" launcher:y="0" >
        <favorite launcher:uri="#Intent;action=android.intent.action.MAIN;category=android.intent.category.APP_BROWSER;end" />
        <favorite launcher:packageName="com.android.chrome" />
    </resolve>

    <favorite
        launcher:container="-101"
        launcher:screen="3"
        launcher:x="3"
        launcher:y="0"
        launcher:packageName="com.android.camera"
        launcher:className="com.android.camera.Camera" />

    <favorite
        launcher:screen="0"
        launcher:x="0"
        launcher:y="-1"
        launcher:packageName="com.google.android.googlequicksearchbox"
	launcher:className="com.google.android.googlequicksearchbox.SearchActivity" />

    <favorite
        launcher:screen="0"
        launcher:x="1"
        launcher:y="-1"
        launcher:packageName="com.google.android.contacts"
	launcher:className="com.android.contacts.activities.PeopleActivity" />
	
    <favorite
        launcher:screen="0"
        launcher:x="2"
        launcher:y="-1"
        launcher:packageName="com.google.android.apps.photos"
        launcher:className="com.google.android.apps.photos.home.HomeActivity" />

    <resolve
        launcher:screen="0"
        launcher:x="3"
        launcher:y="-1" >
        <favorite launcher:uri="#Intent;action=android.intent.action.MAIN;category=android.intent.category.APP_MARKET;end" />
        <favorite launcher:packageName="com.android.vending" />
    </resolve>

</favorites>
